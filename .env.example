# Скопируйте в .env и поменяйте значения. Сам .env в git не попадает.
# .env читают и docker compose, и Spring Boot (spring.config.import в application.yaml).

# Суперпользователь локального postgres (только для контейнера из compose.yaml)
POSTGRES_PASSWORD=postgres

# Подключение auth-service к БД
DB_URL=jdbc:postgresql://localhost:5432/dekanat
DB_USERNAME=auth_svc
DB_PASSWORD=auth_svc

# Администратор, создаваемый при старте, если в БД нет ни одного ADMIN
ADMIN_EMAIL=admin@kubsu.ru
ADMIN_PASSWORD=change-me

# RSA-ключи для подписи JWT (RS256): путь file:... или сам PEM-текст
JWT_PRIVATE_KEY=file:keys/private.pem
JWT_PUBLIC_KEY=file:keys/public.pem

# Почтовый ящик для писем (восстановление пароля и т.п.), SMTP mail.ru.
# APPLICATION_PASSWORD — пароль приложения из настроек безопасности mail.ru, не пароль от ящика
EMAIL=
APPLICATION_PASSWORD=

# Адрес фронта — из него строится ссылка в письме восстановления пароля (по умолчанию http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Redis — общий с gateway: auth-service пишет revoked:user:<id>, gateway читает (по умолчанию localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379

# Ключ шифрования секретов 2FA (AES-256-GCM): 32 случайных байта в Base64, сгенерировать: openssl rand -base64 32
# Если ключ потерять или сменить, все подключённые 2FA придётся настраивать заново
TOTP_ENCRYPTION_KEY=
